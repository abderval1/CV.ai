{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile, role, SaaS plan subscription status and credits balance",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the user matching auth UID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user",
          "maxLength": 180
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"],
          "description": "Role of the user in the SaaS platform"
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"],
          "description": "Account status"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "pro", "executive"],
          "description": "Subscription tier of the SaaS user"
        },
        "billingCycle": {
          "type": "string",
          "enum": ["monthly", "quarterly", "semiannual", "yearly"],
          "description": "Selected billing cycle"
        },
        "targetRole": {
          "type": "string",
          "description": "Target professional role",
          "maxLength": 150
        },
        "company": {
          "type": "string",
          "description": "Company or organization",
          "maxLength": 120
        },
        "avatarUrl": {
          "type": "string",
          "description": "Profile avatar HTTPS URL",
          "maxLength": 500
        },
        "creditsRemaining": {
          "type": "number",
          "description": "AI generation credits balance"
        },
        "creditsUsed": {
          "type": "number",
          "description": "Total AI credits consumed"
        },
        "totalCvGenerated": {
          "type": "number",
          "description": "Total number of resumes/cover letters generated"
        },
        "phone": {
          "type": "string",
          "description": "Contact telephone or WhatsApp number",
          "maxLength": 50
        },
        "subscriptionExpiresAt": {
          "type": "string",
          "description": "Optional ISO expiry timestamp for active plan",
          "maxLength": 50
        },
        "stripeCustomerId": {
          "type": "string",
          "description": "Payment processor customer ID",
          "maxLength": 128
        },
        "stripeSubscriptionId": {
          "type": "string",
          "description": "Payment processor subscription ID",
          "maxLength": 128
        },
        "stripeStatus": {
          "type": "string",
          "enum": ["active", "trialing", "past_due", "canceled", "incomplete"],
          "description": "Subscription renewal status"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp in ISO format",
          "maxLength": 50
        },
        "notes": {
          "type": "string",
          "description": "Internal administrative notes about the customer",
          "maxLength": 1000
        }
      },
      "required": ["id", "name", "email", "plan"]
    },
    "Resume": {
      "title": "Resume",
      "description": "A saved CV document belonging to the user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the resume",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "ID of the owner matching auth UID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Title or name given to this resume version",
          "maxLength": 150
        },
        "targetJob": {
          "type": "string",
          "description": "Target job position or vacancy name",
          "maxLength": 180
        },
        "updatedAt": {
          "type": "string",
          "description": "Formatted timestamp or ISO date of last modification",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 50
        }
      },
      "required": ["id", "userId", "title"]
    },
    "Order": {
      "title": "Order",
      "description": "Subscription payment transaction, order record and invoice",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique transaction ID",
          "maxLength": 128
        },
        "orderNumber": {
          "type": "string",
          "description": "Human-readable invoice/order sequence number",
          "maxLength": 60
        },
        "userId": {
          "type": "string",
          "description": "ID of the customer",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "description": "Customer name",
          "maxLength": 120
        },
        "userEmail": {
          "type": "string",
          "description": "Customer email",
          "maxLength": 180
        },
        "plan": {
          "type": "string",
          "enum": ["free", "pro", "executive"],
          "description": "Purchased subscription tier"
        },
        "billingCycle": {
          "type": "string",
          "enum": ["monthly", "quarterly", "semiannual", "yearly"],
          "description": "Billing cadence"
        },
        "amount": {
          "type": "number",
          "description": "Price paid in nominal currency"
        },
        "currency": {
          "type": "string",
          "description": "Currency code (EUR, USD, AOA, CVE, BRL)",
          "maxLength": 10
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["multicaixa", "card", "transfer", "pix", "stripe", "manual"],
          "description": "Payment gateway or method used"
        },
        "status": {
          "type": "string",
          "enum": ["paid", "pending", "refunded", "failed"],
          "description": "Payment execution status"
        },
        "stripeSubscriptionId": {
          "type": "string",
          "description": "Subscription identifier",
          "maxLength": 128
        },
        "stripePaymentIntentId": {
          "type": "string",
          "description": "Payment intent identifier",
          "maxLength": 128
        },
        "receiptUrl": {
          "type": "string",
          "description": "Payment receipt URL",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "Transaction ISO timestamp",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp",
          "maxLength": 50
        },
        "notes": {
          "type": "string",
          "description": "Additional order notes",
          "maxLength": 500
        }
      },
      "required": ["id", "orderNumber", "userId", "plan", "amount", "status"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount voucher code",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Coupon ID",
          "maxLength": 128
        },
        "code": {
          "type": "string",
          "description": "Promo code in uppercase",
          "maxLength": 40
        },
        "discountPercent": {
          "type": "number",
          "description": "Percentage discount applied (1 to 100)"
        },
        "maxUses": {
          "type": "number",
          "description": "Maximum allowed redeems"
        },
        "usedCount": {
          "type": "number",
          "description": "Current number of redeems"
        },
        "expiresAt": {
          "type": "string",
          "description": "Expiry ISO date string",
          "maxLength": 50
        },
        "active": {
          "type": "boolean",
          "description": "Whether the voucher is currently active"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO date",
          "maxLength": 50
        }
      },
      "required": ["id", "code", "discountPercent", "active"]
    },
    "PlanConfig": {
      "title": "PlanConfig",
      "description": "Dynamic SaaS tier pricing and feature configuration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["free", "pro", "executive"],
          "description": "Plan key identifier"
        },
        "name": {
          "type": "string",
          "description": "Plan display name",
          "maxLength": 80
        },
        "tagline": {
          "type": "string",
          "description": "Marketing description",
          "maxLength": 160
        },
        "priceMonthly": {
          "type": "string",
          "description": "Formatted monthly price label",
          "maxLength": 40
        },
        "priceYearly": {
          "type": "string",
          "description": "Formatted yearly price label",
          "maxLength": 40
        },
        "priceMonthlyValue": {
          "type": "number",
          "description": "Numeric monthly price"
        },
        "priceYearlyValue": {
          "type": "number",
          "description": "Numeric yearly price"
        },
        "currency": {
          "type": "string",
          "description": "Currency code",
          "maxLength": 10
        },
        "creditsMonthly": {
          "type": "number",
          "description": "Monthly credit allowance"
        },
        "isPopular": {
          "type": "boolean",
          "description": "Featured plan badge"
        }
      },
      "required": ["id", "name", "priceMonthlyValue"]
    },
    "PromptConfig": {
      "title": "PromptConfig",
      "description": "No-code AI prompt template configuration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique prompt key",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Prompt display name",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Task category",
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "description": "Prompt description",
          "maxLength": 300
        },
        "systemInstruction": {
          "type": "string",
          "description": "System role prompt",
          "maxLength": 2000
        },
        "userPromptTemplate": {
          "type": "string",
          "description": "Template format with variables",
          "maxLength": 2000
        },
        "temperature": {
          "type": "number",
          "description": "Model temperature"
        },
        "preferredModel": {
          "type": "string",
          "description": "Preferred Gemini model",
          "maxLength": 60
        },
        "fallbackModel": {
          "type": "string",
          "description": "Backup failover model",
          "maxLength": 60
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp",
          "maxLength": 50
        },
        "updatedBy": {
          "type": "string",
          "description": "Admin email who updated",
          "maxLength": 180
        }
      },
      "required": ["id", "name", "systemInstruction"]
    },
    "SystemBanner": {
      "title": "SystemBanner",
      "description": "Platform announcement and notification banner",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Banner ID",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Banner headline",
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "description": "Banner body message",
          "maxLength": 500
        },
        "type": {
          "type": "string",
          "enum": ["info", "warning", "promo", "maintenance"],
          "description": "Banner visual style"
        },
        "active": {
          "type": "boolean",
          "description": "Whether banner is visible"
        },
        "targetAudience": {
          "type": "string",
          "enum": ["all", "free_only", "paid_only"],
          "description": "Target user segment"
        },
        "startsAt": {
          "type": "string",
          "description": "Display start timestamp",
          "maxLength": 50
        },
        "expiresAt": {
          "type": "string",
          "description": "Display end timestamp",
          "maxLength": 50
        }
      },
      "required": ["id", "title", "message", "active"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and sensitive-action audit log in Firestore",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique audit log entry identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 UTC event timestamp",
          "maxLength": 50
        },
        "actorUserId": {
          "type": "string",
          "description": "Authenticated UID or anonymous/system identifier",
          "maxLength": 128
        },
        "actorEmail": {
          "type": "string",
          "description": "Email address of the actor or anonymous",
          "maxLength": 180
        },
        "actorRole": {
          "type": "string",
          "enum": ["user", "admin", "anonymous", "system"],
          "description": "Role of the actor at the time of the event"
        },
        "action": {
          "type": "string",
          "enum": [
            "subscription_upgraded",
            "subscription_canceled",
            "subscription_plan_sync_blocked",
            "payment_order_created",
            "payment_order_status_changed",
            "cv_exported_pdf",
            "cv_exported_docx",
            "cv_exported_json",
            "cv_export_blocked_unauthorized",
            "profile_updated",
            "password_changed",
            "account_login",
            "account_registered",
            "gdpr_request_submitted",
            "unauthorized_access_attempt",
            "admin_user_modified",
            "impersonation_event"
          ],
          "description": "Specific sensitive action or security event type"
        },
        "category": {
          "type": "string",
          "enum": ["subscription", "cv_export", "profile", "security", "admin"],
          "description": "High-level audit domain category"
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "critical"],
          "description": "Security severity level"
        },
        "status": {
          "type": "string",
          "enum": ["success", "blocked", "failure"],
          "description": "Execution outcome of the audited action"
        },
        "targetResource": {
          "type": "string",
          "description": "Affected document path, API endpoint, or CV resource",
          "maxLength": 180
        },
        "details": {
          "type": "string",
          "description": "Sanitized human-readable summary of the event",
          "maxLength": 600
        },
        "metadata": {
          "type": "object",
          "description": "Bounded key-value map of non-secret event context"
        },
        "userAgent": {
          "type": "string",
          "description": "Browser or client user-agent string",
          "maxLength": 250
        },
        "ipAddress": {
          "type": "string",
          "description": "Source IP address captured by server",
          "maxLength": 80
        }
      },
      "required": [
        "id",
        "timestamp",
        "actorUserId",
        "actorEmail",
        "actorRole",
        "action",
        "category",
        "severity",
        "status",
        "targetResource",
        "details"
      ]
    },
    "NotificationPreferences": {
      "title": "NotificationPreferences",
      "description": "User preferences for in-app system and email notifications across translations, exports, and resume updates",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Preference document identifier (notifications)",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID matching auth UID",
          "maxLength": 128
        },
        "systemEnabled": {
          "type": "boolean",
          "description": "Master toggle for in-app system notifications"
        },
        "emailEnabled": {
          "type": "boolean",
          "description": "Master toggle for email notifications"
        },
        "events": {
          "type": "object",
          "description": "Per-event channel toggles for translation, export, and resumeUpdate"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last modification ISO 8601 timestamp",
          "maxLength": 50
        }
      },
      "required": ["id", "userId", "systemEnabled", "emailEnabled", "events", "updatedAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Individual system/email notification event belonging to a user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique notification identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID matching auth UID",
          "maxLength": 128
        },
        "eventType": {
          "type": "string",
          "enum": ["translation", "export", "resume_update"],
          "description": "Event trigger category"
        },
        "title": {
          "type": "string",
          "description": "Notification headline",
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "description": "Notification descriptive message",
          "maxLength": 500
        },
        "channelSystem": {
          "type": "boolean",
          "description": "Whether system notification was enabled for this event"
        },
        "channelEmail": {
          "type": "boolean",
          "description": "Whether email notification was enabled for this event"
        },
        "emailDeliveryStatus": {
          "type": "string",
          "enum": ["not_requested", "sent", "queued"],
          "description": "Email dispatch outcome"
        },
        "read": {
          "type": "boolean",
          "description": "Read status flag"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO 8601 timestamp",
          "maxLength": 50
        },
        "targetResource": {
          "type": "string",
          "description": "Optional related resource path",
          "maxLength": 180
        }
      },
      "required": [
        "id",
        "userId",
        "eventType",
        "title",
        "message",
        "channelSystem",
        "channelEmail",
        "emailDeliveryStatus",
        "read",
        "createdAt"
      ]
    },
    "SupportThread": {
      "title": "SupportThread",
      "description": "Support conversation thread between a registered user and system administrators or moderators",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique thread identifier matching owner UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "description": "Display name of the registered user",
          "maxLength": 120
        },
        "userEmail": {
          "type": "string",
          "description": "Email address of the registered user",
          "maxLength": 180
        },
        "userAvatarUrl": {
          "type": "string",
          "description": "Optional profile avatar URL",
          "maxLength": 500
        },
        "userPlan": {
          "type": "string",
          "enum": ["free", "pro", "executive"],
          "description": "Active subscription tier of user"
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"],
          "description": "Support ticket status"
        },
        "lastMessageText": {
          "type": "string",
          "description": "Latest message preview",
          "maxLength": 500
        },
        "lastMessageSenderRole": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "Role of sender of the last message"
        },
        "lastMessageAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of the latest message",
          "maxLength": 50
        },
        "unreadByUser": {
          "type": "number",
          "description": "Number of unread admin replies for the user"
        },
        "unreadByAdmin": {
          "type": "number",
          "description": "Number of unread user messages for admins/moderators"
        },
        "createdAt": {
          "type": "string",
          "description": "Thread creation timestamp",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Thread update timestamp",
          "maxLength": 50
        }
      },
      "required": ["id", "userId", "userName", "userEmail", "status", "lastMessageAt", "unreadByUser", "unreadByAdmin", "createdAt", "updatedAt"]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Immutable chat message within a support conversation thread",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "threadId": {
          "type": "string",
          "description": "Parent thread ID",
          "maxLength": 128
        },
        "senderId": {
          "type": "string",
          "description": "UID of sender",
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "description": "Sender display name",
          "maxLength": 120
        },
        "senderRole": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "Role of sender (user or admin/moderator)"
        },
        "text": {
          "type": "string",
          "description": "Message body text",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 message creation timestamp",
          "maxLength": 50
        }
      },
      "required": ["id", "threadId", "senderId", "senderName", "senderRole", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile, roles, and SaaS subscription information"
    },
    "/users/{userId}/resumes/{resumeId}": {
      "schema": "Resume",
      "description": "Subcollection of saved resumes and tailored versions created by the user"
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": "NotificationPreferences",
      "description": "Subcollection storing user notification channel and event preferences"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "UserNotification",
      "description": "Subcollection storing user system and email notification records"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Stores all subscription sales transactions, billing records and payment statuses"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Stores promotional discount coupon codes and redemption counters"
    },
    "/plansConfig/{planId}": {
      "schema": "PlanConfig",
      "description": "Stores system tier pricing, feature flags and credit allowances"
    },
    "/promptsConfig/{promptId}": {
      "schema": "PromptConfig",
      "description": "Stores no-code AI prompt templates and model routing rules"
    },
    "/systemBanners/{bannerId}": {
      "schema": "SystemBanner",
      "description": "Stores in-app broadcast alerts, maintenance and promotion banners"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Stores immutable security audit logs for sensitive user actions and unauthorized access attempts"
    },
    "/supportThreads/{threadId}": {
      "schema": "SupportThread",
      "description": "Stores support conversation threads between registered users and system administrators/moderators"
    },
    "/supportThreads/{threadId}/messages/{messageId}": {
      "schema": "SupportMessage",
      "description": "Subcollection storing immutable messages exchanged in a support thread"
    }
  }
}
