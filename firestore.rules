rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Bootstrapped Admin logic (matching user email or explicitly registered in admins doc)
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email is string && request.auth.token.email.lower() == 'gugurai923@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'plan']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 120 &&
             data.email is string && data.email.size() <= 180 &&
             data.plan in ['free', 'pro', 'executive'];
    }

    function isValidResume(data) {
      return data.keys().hasAll(['id', 'userId', 'title']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 150;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'userId', 'plan', 'amount', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.orderNumber is string && data.orderNumber.size() <= 60 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.plan in ['free', 'pro', 'executive'] &&
             data.amount is number &&
             data.status in ['paid', 'pending', 'refunded', 'failed'];
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['id', 'code', 'discountPercent', 'active']) &&
             data.id is string && data.id.size() <= 128 &&
             data.code is string && data.code.size() <= 40 &&
             data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100 &&
             data.active is bool;
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read, write: if isAdmin() && isValidId(adminId);
    }

    // Users collection: Private user profile, plan and credits
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();

      allow create: if (
        (isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && incoming().id == request.auth.uid) ||
        (isAdmin() && isValidUser(incoming()))
      );

      allow update: if (
        isAdmin() ||
        (
          isSignedIn() &&
          request.auth.uid == userId &&
          isValidUser(incoming()) &&
          incoming().id == existing().id &&
          incoming().email == existing().email &&
          (!('role' in incoming()) || incoming().role == existing().get('role', 'user'))
        )
      );

      allow delete: if isAdmin();

      // User resumes subcollection
      match /resumes/{resumeId} {
        allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidId(resumeId);
        allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

        allow create: if isSignedIn() && 
                         (request.auth.uid == userId || isAdmin()) && 
                         isValidId(resumeId) && 
                         isValidResume(incoming()) &&
                         (incoming().userId == request.auth.uid || isAdmin());

        allow update: if isSignedIn() && 
                         (request.auth.uid == userId || isAdmin()) && 
                         isValidId(resumeId) && 
                         isValidResume(incoming()) &&
                         incoming().userId == existing().userId;

        allow delete: if isSignedIn() && 
                         (request.auth.uid == userId || isAdmin()) && 
                         isValidId(resumeId);
      }
    }

    // Orders & Transactions collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && (isAdmin() || (resource.data.userId == request.auth.uid) || (resource.data.userEmail == request.auth.token.email)) && isValidId(orderId);
      allow list: if isSignedIn() && (isAdmin() || (resource.data.userId == request.auth.uid) || (resource.data.userEmail == request.auth.token.email));

      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && (isAdmin() || incoming().userId == request.auth.uid);
      allow update: if isSignedIn() && isValidId(orderId) && (isAdmin() || (existing().userId == request.auth.uid));
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Discount Coupons collection
    match /coupons/{couponId} {
      allow get: if isSignedIn() && isValidId(couponId);
      allow list: if isSignedIn();

      allow create: if isAdmin() && isValidId(couponId) && isValidCoupon(incoming());
      allow update: if isAdmin() && isValidId(couponId) && isValidCoupon(incoming());
      allow delete: if isAdmin() && isValidId(couponId);
    }

    // System SaaS Plan Configurations
    match /plansConfig/{planId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(planId);
    }

    // AI Prompts Configuration (No-Code Prompt Management)
    match /promptsConfig/{promptId} {
      allow read: if isAdmin() && isValidId(promptId);
      allow write: if isAdmin() && isValidId(promptId);
    }

    // System Broadcast Banners
    match /systemBanners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(bannerId);
    }

    // System Settings & Routing (editablePlans and platformGovernance readable by frontend; aiRouting & all writes strictly Admin)
    match /systemSettings/{settingId} {
      allow get: if isValidId(settingId) && (settingId in ['editablePlans', 'platformGovernance'] || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(settingId);
    }

    // Plan Quotas
    match /planQuotas/{quotaId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(quotaId);
    }

    // Template Catalog Admin Config
    match /templateCatalogConfig/{templateId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(templateId);
    }

    // Profession Snippet Library
    match /professionSnippets/{snippetId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(snippetId);
    }

    // System Locales
    match /systemLocales/{localeId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(localeId);
    }

    // Technical Generation Error Logs (clients can log failures, only Admins can read/resolve/delete)
    match /generationErrorLogs/{logId} {
      allow read, update, delete: if isAdmin() && isValidId(logId);
      allow create: if isSignedIn() && isValidId(logId) && incoming().keys().hasAll(['id', 'timestamp', 'operationType', 'errorMessage', 'resolved']);
    }

    // GDPR / LGPD Requests
    match /gdprRequests/{requestId} {
      allow read, write: if isAdmin() && isValidId(requestId);
    }

    // Impersonation Audit Logs
    match /impersonationAuditLogs/{logId} {
      allow read, write: if isAdmin() && isValidId(logId);
    }
  }
}
